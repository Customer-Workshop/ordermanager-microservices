{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "customers-route": {
        "ClusterId": "customer-service",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },
      "products-route": {
        "ClusterId": "product-service",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "inventory-route": {
        "ClusterId": "inventory-service",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "order-service",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "customer-service": {
        "Destinations": {
          "default": {
            "Address": "http://customer-service:8080"
          }
        }
      },
      "product-service": {
        "Destinations": {
          "default": {
            "Address": "http://product-service:8080"
          }
        }
      },
      "inventory-service": {
        "Destinations": {
          "default": {
            "Address": "http://inventory-service:8080"
          }
        }
      },
      "order-service": {
        "Destinations": {
          "default": {
            "Address": "http://order-service:8080"
          }
        }
      }
    }
  }
}
